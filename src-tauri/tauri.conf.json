{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AeroTab",
  "version": "0.2.5",
  "identifier": "com.aerotab",
  "build": {
    "beforeDevCommand": "cd apps/ui && npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd apps/ui && npm run build",
    "frontendDist": "../apps/ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "AeroTab 0.2.5",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 400,
        "transparent": true,
        "backgroundColor": "#0b0d12"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "A terminal for the modern age.",
    "longDescription": "AeroTab — cross-platform SSH, serial, and terminal client (Rust + Tauri).",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDczQ0VEOTE3NEREREZGN0UKUldSKy85MU5GOW5PYzJXNG5qKy8yVHlxMndFWktRd3FjaWlDanljWFI0ckZvaHRRR05FTjErQVoK",
      "endpoints": [
        "https://example.invalid/aerotab/{{target}}/{{current_version}}"
      ]
    }
  }
}
